{
  "schemaVersion": 1,
  "id": "obotaddon",
  "version": "${version}",
  "name": "Obot Addon",
  "description": "Meteor Client addon: tracks + glows opened chests, and auto-collects missing materials according to Litematica's Material List.",
  "authors": [
    "you"
  ],
  "contact": {},
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.obot.chest.ObotAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "80, 200, 255"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  },
  "recommends": {
    "litematica": "*"
  }
}
